set(CMAKE_SYSTEM_NAME Windows)
if(NOT CED_WINDOWS_ARCH MATCHES "^(i686|x86_64|aarch64)$")
    message(FATAL_ERROR "Set CED_WINDOWS_ARCH to i686, x86_64 or aarch64")
endif()
set(CMAKE_SYSTEM_PROCESSOR "${CED_WINDOWS_ARCH}")
set(CMAKE_C_COMPILER "${CED_WINDOWS_ARCH}-w64-mingw32-clang")
set(CMAKE_RC_COMPILER "${CED_WINDOWS_ARCH}-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "/opt/llvm-mingw/${CED_WINDOWS_ARCH}-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CED_WINDOWS_ARCH)
